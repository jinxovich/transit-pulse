# Пресет потока replayer (docker compose подхватывает .env автоматически)
REPLAY_START=07:00        # с какого сим-времени дня 2026-01-06 начать
REPLAY_SPEED=30           # сим-секунд в секунду
REPLAY_LOOP=1             # по концу дня начать заново с новой сессией
REPLAY_WARMUP_MIN=30      # прогрев: столько сим-минут до старта проигрываются быстро
REPLAY_AUTOSTART=1
FLEET_MULTIPLIER=1        # нагрузочный тест: клонировать каждый борт k раз

# Политика инцидентов (docs/perf/alert_policy.md); раскраска карты от неё не зависит
ALERT_DELAY_S=120         # алерт, если прогноз задержки > X c …
ALERT_P_LATE=0.5          # … или/и P(опоздание > 120 c) ≥ Y
ALERT_MODE=or             # or | and — как сочетать два условия
ALERT_MIN_STREAK=3        # столько проходов (сим-минут) подряд визит должен держать условие

# Порты на хосте (если стандартные заняты)
DASHBOARD_PORT=8080
BACKEND_PORT=8000
ML_PORT=8001
REPLAYER_PORT=8090
NDTP_PORT=9201
